# Never track secrets or machine-specific configuration.
.zshsecrets
.zshrc.local
.zprofile.local
.gitconfig.local
.tmux.conf.local
.secrets/
*.token
*_rsa
*_ed25519
*.pem

# Neovim state that is generated, not configured. Plugins install into
# ~/.local/share/nvim; only lazy-lock.json belongs in version control.
.config/nvim/plugin/
.config/nvim/spell/
.config/nvim/nvim-pack-lock.json
.local/share/

# Archives and binaries
*.tar.gz
*.zip

# macOS
.DS_Store
