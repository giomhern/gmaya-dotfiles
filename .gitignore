# Never track secrets. .zshrc sources both of these at startup; they hold
# credentials and must stay on the machine only.
.zshsecrets
.secrets/
*.token
*_rsa
*_ed25519
*.pem

# Neovim state that is generated, not configured. Plugins install into
# ~/.local/share/nvim; only the lock file belongs in version control.
.config/nvim/plugin/
.config/nvim/spell/
.local/share/

# btop has no way to pick a theme at launch, so btop.conf points at
# themes/current.theme and .zshrc repoints that symlink at the latte or
# macchiato theme to match macOS appearance. The target is machine state, not
# configuration — both real theme files are tracked.
.config/btop/themes/current.theme

# Archives and binaries
*.tar.gz
*.zip

# macOS
.DS_Store
