# Never track secrets. .zshrc sources both of these at startup; they hold
# credentials and must stay on the machine only.
.zshsecrets
.secrets/
*.token
*_rsa
*_ed25519
*.pem

# Neovim state that is generated, not configured. Plugins install into
# ~/.local/share/nvim; only the lock file belongs in version control.
.config/nvim/plugin/
.config/nvim/spell/
.local/share/

# Archives and binaries
*.tar.gz
*.zip

# macOS
.DS_Store
